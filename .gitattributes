# Enforce LF line endings for all text files in this repo.
# Fixes the CRLF inconsistency found in GameHeader.js and ResultScreen.js.
* text=auto eol=lf

# Explicitly treat JS/JSON/CSS/HTML as text
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.env  text eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.ico  binary
*.wav  binary
*.mp3  binary
